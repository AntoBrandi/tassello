{
  // The published server (dist/server, its shared modules in dist/shared) and
  // Vite plugin (dist/vite): JavaScript, as Node does not run TypeScript from
  // node_modules, with their declarations (tassello/server, tassello/vite)
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/server/**/*.ts", "src/vite/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
