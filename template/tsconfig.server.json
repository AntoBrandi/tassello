{
  // The server's side, built into dist/server: Node runs JavaScript from
  // node_modules, not TypeScript
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "rootDir": "src/server",
    "outDir": "dist/server"
  },
  "include": ["src/server"]
}
